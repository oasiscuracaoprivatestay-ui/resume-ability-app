# ── Client Environment Variables (Vite) ─────────────────────────
# Public VAPID key used by the browser PushManager. Safe for client exposure.
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key_here

# ── Server / Vercel Environment Variables ─────────────────────────
# NEVER prefix private keys with VITE_. Set these in the Vercel Dashboard Settings -> Environment Variables.
VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here
VAPID_SUBJECT=mailto:support@superdietability.com

# Optional security token to protect api/cron/reminders against unauthorized requests
CRON_SECRET=your_cron_secret_token_here
